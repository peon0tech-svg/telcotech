---
import Layout from '../layouts/Layout.astro';
import DataTable from '../components/DataTable.astro';
import data from '../data/numbers.json';
---

<Layout title="Telephony Numbers - Telco Tech">
  <div class="mb-8 flex items-center justify-between">
    <div>
      <a href="/" class="text-[var(--accent-color)] hover:underline mb-2 inline-block"><- Back to Core</a>
      <h1 class="text-3xl md:text-5xl font-bold uppercase tracking-tighter">
        Telephony Numbers
      </h1>
    </div>
    <div class="text-right hidden md:block">
      <div class="text-xs uppercase opacity-70">Total Records</div>
      <div class="text-3xl font-light text-[var(--accent-color)]">{data.length}</div>
    </div>
  </div>

  <DataTable dataset={data} />
</Layout>

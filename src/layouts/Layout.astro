---
import '../styles/global.css';

export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Telecommunication Technology Namibia Documentation Website">
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return 'dark';
			})();
			
			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
			if (typeof localStorage !== 'undefined') {
				localStorage.setItem('theme', theme);
			}
		</script>
	</head>
	<body class="min-h-screen bg-[var(--bg-color)] text-[var(--text-color)] font-mono selection:bg-[var(--accent-color)] selection:text-[var(--bg-color)]">
		<nav class="border-b border-[var(--bento-border)] p-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-[var(--bento-bg)] relative z-10 shadow-[var(--glow)]">
			<div class="flex items-center w-full md:w-auto overflow-hidden">
                <a href="/" id="typewriter" class="text-base sm:text-xl font-bold tracking-widest sm:tracking-wider hover:text-[var(--accent-color)] transition-colors cursor-pointer inline-block w-full sm:min-w-[280px] whitespace-nowrap">
                    > TELCO_TECH_NAMIBIA_
                </a>
            </div>
			<div>
				<button id="theme-toggle" class="terminal-box px-3 py-1.5 md:px-4 md:py-2 text-xs md:text-sm uppercase tracking-widest font-bold whitespace-nowrap">
					Toggle Theme
				</button>
			</div>
		</nav>
        <div class="fixed inset-0 z-0 opacity-20 pointer-events-none" style="background-image: url('/tech-bg.png'); background-size: cover; background-position: center; mix-blend-mode: screen;"></div>
		<main class="container mx-auto px-4 py-6 md:px-6 relative z-10">
			<slot />
		</main>
        
        <script>
            // Typewriter effect
            const typeTarget = document.getElementById('typewriter');
            if (typeTarget) {
                const text = "> TELCO_TECH_NAMIBIA_";
                let i = 0;
                let isDeleting = false;
                
                function typeWriter() {
                    if (!isDeleting && i <= text.length) {
                        typeTarget.innerHTML = text.substring(0, i) + '<span class="animate-pulse opacity-70">_</span>';
                        i++;
                        setTimeout(typeWriter, Math.random() * 50 + 100);
                    } else if (isDeleting && i > 2) {
                        i--;
                        typeTarget.innerHTML = text.substring(0, i) + '<span class="animate-pulse opacity-70">_</span>';
                        setTimeout(typeWriter, 40);
                    } else {
                        isDeleting = !isDeleting;
                        setTimeout(typeWriter, isDeleting ? 3000 : 500);
                    }
                }
                setTimeout(typeWriter, 1000);
            }

            const handleToggleClick = () => {
                const element = document.documentElement;
                element.classList.toggle('dark');
                const isDark = element.classList.contains('dark');
                localStorage.setItem('theme', isDark ? 'dark' : 'light');
            };

            const themeToggleBtn = document.getElementById('theme-toggle');
            if (themeToggleBtn) {
                themeToggleBtn.addEventListener('click', handleToggleClick);
            }
            
            // Re-bind on ViewTransitions page load if enabled in future
            document.addEventListener('astro:page-load', () => {
                const btn = document.getElementById('theme-toggle');
                if (btn) btn.addEventListener('click', handleToggleClick);
            });
        </script>
	</body>
</html>
